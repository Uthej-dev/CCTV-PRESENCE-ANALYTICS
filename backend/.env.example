ENVIRONMENT=development
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=cctv_analytics
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173

# Computer vision
VIDEO_DIR=videos
YOLO_MODEL=weights/yolo11n.pt
YOLO_DEVICE=
PROCESS_FPS=12
MAX_RUNNING_CAMERAS=4

# Analytics / uploads
TIMEZONE=UTC
MIN_VISIT_SECONDS=1.0
SNAPSHOT_RETENTION_DAYS=90
MAX_UPLOAD_MB=200

# Video recordings
MEDIA_DIR=media
RECORDING_PRE_ROLL_SECONDS=2
RECORDING_POST_ROLL_SECONDS=5
RECORDING_MAX_CLIP_SECONDS=300
RECORDING_RETENTION_DAYS=7
